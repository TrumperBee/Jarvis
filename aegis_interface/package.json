{
  "name": "aegis-os",
  "productName": "AEGIS OS",
  "version": "2.0.0",
  "description": "AEGIS OS - Advanced Engineering & General Intelligence System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite --host & sleep 3 && electron .",
    "vite": "vite --host",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "keywords": ["aegis", "ai", "operating system", "electron", "three.js", "voice assistant"],
  "author": "AEGIS OS Development Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "three": "^0.164.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.aegis.os",
    "productName": "AEGIS OS",
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "src/assets/icon.ico"
    }
  }
}
